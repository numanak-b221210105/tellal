# Kopyalayıp .env olarak kaydedin. .env dosyası git'e gönderilmez.
# Hiçbiri zorunlu değil: varsayılan demo modu hiçbir hesap ya da anahtar istemez.

# demo: simüle edilmiş Instagram hesabı (deneme ve sunum için)
# instagram: gerçek hesap (Meta uygulaması gerekir, README > Instagram bağlantısı)
TELLAL_MODE=demo

# Sunucunun internetten erişilebilen adresi. Instagram fotoğraf ve videoları buradan indirir.
# Gerçek kullanımda https ile bir alan adı ya da tünel (Cloudflare Tunnel, ngrok) gerekir.
TELLAL_PUBLIC_URL=http://localhost:8300

# Instagram API with Instagram Login (developers.facebook.com üzerinde kendi uygulamanız)
TELLAL_IG_APP_ID=
TELLAL_IG_APP_SECRET=
TELLAL_IG_API_VERSION=v25.0

# Panel şifresi: sunucu internete açıksa mutlaka ayarlayın
TELLAL_ADMIN_PASSWORD=

TELLAL_DATA_DIR=data
TELLAL_TIMEZONE=Europe/Istanbul

# İsteğe bağlı dil modeli (OpenAI uyumlu herhangi bir uç nokta). Yoksa şablon motoru çalışır.
# Ücretsiz ve yerel: https://ollama.com  ->  ollama pull qwen2.5:7b-instruct
TELLAL_LLM=auto
TELLAL_LLM_BASE_URL=http://localhost:11434/v1
TELLAL_LLM_API_KEY=ollama
TELLAL_LLM_MODEL=qwen2.5:7b-instruct
# Başka bir sağlayıcı:
# TELLAL_LLM_BASE_URL=https://api.openai.com/v1
# TELLAL_LLM_API_KEY=sk-...
# TELLAL_LLM_MODEL=<sağlayıcının güncel model adı>
